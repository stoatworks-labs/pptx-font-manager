# connect-src must list raw.githubusercontent.com — that is where font files
# come from. NOT fonts.googleapis.com: the CSS API only serves subsetted woff2
# to a browser UA, which is useless for installation. See
# scripts/build-catalogue.mjs. A too-narrow CSP here fails only in production,
# where _headers applies and the dev server's absence of it hides the problem.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data: blob:; connect-src 'self' https://raw.githubusercontent.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable
