# connect-src must list BOTH font sources, or downloads fail:
#
#   raw.githubusercontent.com  Google Fonts — the original complete .ttf files
#   cdn.jsdelivr.net           Fontsource — the ~120 families Google lacks
#
# NOT fonts.googleapis.com: the CSS API only serves subsetted woff2 to a
# browser UA, which is useless for installation. See scripts/build-catalogue.mjs
# and scripts/build-fontsource-catalogue.mjs. A too-narrow CSP here fails only
# in production, where _headers applies and the dev server's absence of it hides
# the problem — check it with `npm run serve:dist`.
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; worker-src 'self'; manifest-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data: blob:; connect-src 'self' https://raw.githubusercontent.com https://cdn.jsdelivr.net https://intake.stoatworks-labs.com; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The worker is the one file that must never be served stale: a cached sw.js
# is a cached update mechanism, and the app would stop being able to replace
# itself. Everything it caches is content-hashed and immutable, so nothing is
# lost by revalidating this one small file every time.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Cache-Control: no-cache
