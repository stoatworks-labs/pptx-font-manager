# Real presentations used as fixtures are private and stay local. The
# synthetic ones are generated by scripts/make-test-deck.mjs and
# scripts/make-media-deck.mjs and ARE committed,
# so the suite tests something on a clean clone and in CI. online-video.pptx
# was made in PowerPoint for Mac and holds nothing private.
test/fixtures/*.pptx
!test/fixtures/synthetic.pptx
!test/fixtures/media.pptx
!test/fixtures/online-video.pptx

